# Copy this file to .env and replace the placeholders with local values.
# The deployment scripts load .env before compiling the firmware.

WIFI_SSID=your-network-name
WIFI_PASSWORD=your-network-password
MQTT_HOST=broker.example.com

# Optional settings. Uncomment any value you want to override.
# MQTT_PORT=1883
# MQTT_TOPIC=pico-data-logger/readings
# MQTT_CLIENT_ID=pico-data-logger
# MQTT_USERNAME=your-mqtt-username
# MQTT_PASSWORD=your-mqtt-password
# NTP_HOST=pool.ntp.org
